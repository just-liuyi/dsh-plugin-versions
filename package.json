{
  "name": "dsh-plugin-versions",
  "version": "0.1.2",
  "description": "Installed-plugin manager for DeepSeek Harness: list published versions of an installed plugin, switch or roll back, and uninstall, from Settings -> Plugins.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin-manager",
    "versions",
    "rollback"
  ],
  "author": "DangDangDeng",
  "license": "MIT",
  "homepage": "https://github.com/DangDangDeng/dsh-plugin-versions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DangDangDeng/dsh-plugin-versions.git"
  },
  "bugs": {
    "url": "https://github.com/DangDangDeng/dsh-plugin-versions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
